local PetService={}
function PetService.Init(ctx) PetService.Context=ctx; PetService.Active={}; PetService.ActiveName={}; PetService.Owned={}; game:GetService("Players").PlayerAdded:Connect(function(player) task.spawn(function()for _=1,300 do local data=ctx.Data.Data[player]; if data then PetService.Owned[player]=data.Pets or {}; if data.ActivePet and PetService.Owned[player][data.ActivePet] then PetService.Equip(player,data.ActivePet)end; return end; task.wait(.1)end end)end); game:GetService("Players").PlayerRemoving:Connect(function(player) if PetService.Active[player] then PetService.Active[player]:Destroy() end; PetService.Active[player]=nil; PetService.ActiveName[player]=nil; PetService.Owned[player]=nil end); local rem=ctx.Remotes.EquipPet
 rem.OnServerEvent:Connect(function(player,name) if name=="__UNEQUIP__" then PetService.Unequip(player); return end; if type(name)~="string" or not table.find(require(game:GetService("ReplicatedStorage").Modules.Config).Pets,name) or not (PetService.Owned[player] and PetService.Owned[player][name]) then return end; PetService.Equip(player,name) end)
 task.spawn(function() while true do task.wait(.1); for player,pet in pairs(PetService.Active) do local char=player.Character; local root=char and char:FindFirstChild("HumanoidRootPart"); if root and pet.Parent then local target=root.CFrame*CFrame.new(3,1.5+math.sin(os.clock()*3)*.25,3); pet.Position=pet.Position:Lerp(target.Position,.18); pet.CFrame=CFrame.new(pet.Position)*CFrame.Angles(0,os.clock()*1.4,0) end end end end)
end
function PetService.Equip(player,name) if PetService.Active[player] then PetService.Active[player]:Destroy() end; local p=Instance.new("Part"); p.Name=name.." Pet"; p.Shape=name=="Toilet" and Enum.PartType.Block or Enum.PartType.Ball; p.Size=Vector3.new(2,2,2); p.Color=({Chicken=Color3.fromRGB(255,220,40),Banana=Color3.fromRGB(255,240,20),Potato=Color3.fromRGB(150,96,55),Toilet=Color3.fromRGB(235,240,255),["Mini NPC"]=Color3.fromRGB(255,100,100),["Giant Hamster"]=Color3.fromRGB(205,140,90),["Dancing Frog"]=Color3.fromRGB(45,205,80),["Floating Head"]=Color3.fromRGB(240,170,195)})[name] or Color3.new(1,1,1); p.Anchored=true; p.CanCollide=false; p.Parent=workspace; if name=="Giant Hamster" or name=="Dancing Frog" or name=="Floating Head" then local light=Instance.new("PointLight"); light.Color=p.Color; light.Brightness=1; light.Range=8; light.Parent=p end; PetService.Active[player]=p; PetService.ActiveName[player]=name end
function PetService.Unequip(player)
 local pet=PetService.Active[player]; if pet and pet.Parent then pet:Destroy() end
 PetService.Active[player]=nil; PetService.ActiveName[player]=nil
end
return PetService
