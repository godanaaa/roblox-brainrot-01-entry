local Daily={}
Daily.Challenges={{Name="Survive 10 events",Goal=10,Key="EventsSurvived",Reward=500},{Name="Get launched 5 times",Goal=5,Key="Launched",Reward=250},{Name="Find a secret room",Goal=1,Key="SecretRoom",Reward=300},{Name="Win a mini-game",Goal=1,Key="MinigameWins",Reward=400}}
function Daily.Init(ctx) Daily.Context=ctx; Daily.Progress={}; game:GetService("Players").PlayerAdded:Connect(function(player) task.spawn(function()for _=1,300 do local data=ctx.Data.Data[player]; if data then Daily.Progress[player]=data.Daily or {}; return end; task.wait(.1)end end)end); ctx.Remotes.Panel.OnServerEvent:Connect(function(p,action) if action=="Daily" then ctx.Remotes.State:FireClient(p,{Daily=Daily.Challenges,Progress=Daily.Progress[p] or {}}) end end) end
function Daily.Increment(player,key,amount) Daily.Progress[player]=Daily.Progress[player] or {}; local n=(Daily.Progress[player][key] or 0)+(amount or 1); Daily.Progress[player][key]=n; for _,c in ipairs(Daily.Challenges) do if c.Key==key and n>=c.Goal and not Daily.Progress[player]["Done"..key] then Daily.Progress[player]["Done"..key]=true; Daily.Context.Coin.Add(player,c.Reward,"daily challenge") end end end
return Daily
