local Secret={}
local Players=game:GetService("Players")
function Secret.Init(ctx) Secret.Context=ctx; Secret.Found={}; Secret.LastMove={}; Secret.LastPosition={}; local map=workspace:WaitForChild("BrainrotMap")
 for _,obj in ipairs(map:GetDescendants()) do local index=obj:GetAttribute("SecretIndex"); if index then local prompt=Instance.new("ProximityPrompt"); prompt.ActionText="Press secret"; prompt.ObjectText="Suspicious Button"; prompt.HoldDuration=.3; prompt.MaxActivationDistance=10; prompt.Parent=obj; prompt.Triggered:Connect(function(p) if Secret.Found[p] and Secret.Found[p][index] then return end; Secret.Found[p]=Secret.Found[p] or {}; local saved=ctx.Data.Data[p] and ctx.Data.Data[p].Secrets or {}; if saved[tostring(index)] or Secret.Found[p][index] then return end; Secret.Found[p][index]=true; ctx.Data.MarkSecret(p,index); ctx.Coin.Add(p,150,"secret found"); local n=0; for _ in pairs(Secret.Found[p]) do n+=1 end; ctx.Remotes.Announcement:FireClient(p,"Secret button "..n.."/5 found!"); if n>=5 then ctx.Announce.All("SECRET EVENT UNLOCKED • COIN SHOWER!"); for _,plr in ipairs(Players:GetPlayers()) do ctx.Coin.Add(plr,100,"secret event coin shower") end; ctx.Brainrot.SpawnLegendary() end end) end end
 local room=map:FindFirstChild("Meme Laboratory"); if room then local trigger=Instance.new("Part"); trigger.Name="Secret Room Trigger"; trigger.Size=Vector3.new(20,10,16); trigger.Position=Vector3.new(-20,-5,208); trigger.Transparency=1; trigger.CanCollide=false; trigger.Anchored=true; trigger.Parent=room; local seen={}; trigger.Touched:Connect(function(hit) local p=Players:GetPlayerFromCharacter(hit.Parent); if p and not seen[p] then seen[p]=true; ctx.Announce.To(p,"YOU WERE NOT SUPPOSED TO FIND THIS"); ctx.Coin.Add(p,150,"secret room"); ctx.Daily.Increment(p,"SecretRoom",1) end end) end
 task.spawn(function() while true do task.wait(2); local n=0; for _,p in ipairs(Players:GetPlayers()) do local r=p.Character and p.Character:FindFirstChild("HumanoidRootPart"); if r and (r.Position-Vector3.new(-145,1,-140)).Magnitude<24 then n+=1 end end; if n>=2 then if not Secret.Council then Secret.Council=true; ctx.Announce.All("THE COUNCIL HAS ASSEMBLED"); for _,p in ipairs(Players:GetPlayers()) do ctx.Coin.Add(p,50,"council assembled") end end else Secret.Council=false end end end)
 Players.PlayerAdded:Connect(function(p) Secret.LastMove[p]=os.clock(); task.spawn(function()for _=1,300 do local data=ctx.Data.Data[p]; if data then Secret.Found[p]={}; for key,value in pairs(data.Secrets or {})do if value then Secret.Found[p][tonumber(key) or key]=true end end; return end; task.wait(.1)end end); p.CharacterAdded:Connect(function(c) Secret.LastPosition[p]=c:WaitForChild("HumanoidRootPart",5) and c.HumanoidRootPart.Position end) end)
 task.spawn(function() while true do task.wait(5); for _,p in ipairs(Players:GetPlayers()) do local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart"); if root then local old=Secret.LastPosition[p]; if not old or (root.Position-old).Magnitude>2 then Secret.LastMove[p]=os.clock(); Secret.LastPosition[p]=root.Position; if p:GetAttribute("AFK") then p:SetAttribute("AFK",false); local c=p.Character; local gui=c and c:FindFirstChild("AFKLabel",true); if gui then gui:Destroy() end end elseif os.clock()-(Secret.LastMove[p] or os.clock())>=300 and not p:GetAttribute("AFK") then p:SetAttribute("AFK",true); ctx.Announce.To(p,"BRO HAS BEEN AFK FOR 10 YEARS 💀"); local head=p.Character:FindFirstChild("Head"); if head then local gui=Instance.new("BillboardGui"); gui.Name="AFKLabel"; gui.Size=UDim2.fromOffset(240,38); gui.StudsOffset=Vector3.new(0,3,0); gui.Parent=head; local text=Instance.new("TextLabel"); text.Size=UDim2.fromScale(1,1); text.BackgroundTransparency=1; text.Text="AFK FOR 10 YEARS 💀"; text.TextScaled=true; text.Font=Enum.Font.FredokaOne; text.TextColor3=Color3.fromRGB(255,220,80); text.Parent=gui end end end end end end)
end
return Secret
