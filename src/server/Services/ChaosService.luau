function Chaos.Init(ctx) Chaos.Context=ctx; Chaos.Meter=0; Chaos.Last=nil; Chaos.Count=0; Chaos.Current="Waiting for chaos"; Chaos.EndAt=0; Chaos.DoubleIncomeUntil=0
