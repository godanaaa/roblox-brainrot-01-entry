 local beak=Instance.new("Part"); beak.Name="Beak"; beak.Size=Vector3.new(size*.35,size*.25,size*.4); beak.Color=Color3.fromRGB(255,110,20); beak.Anchored=true; beak.Position=position+Vector3.new(0,0,-size*.6); beak.Parent=m
