  local wall=Instance.new("Part"); wall.Name="Brainrot Tsunami Wave"; wall.Size=Vector3.new(12,42,420); wall.Position=Vector3.new(-215,18,0); wall.Anchored=true; wall.CanCollide=false; wall.Transparency=.22; wall.Color=Color3.fromRGB(38,190,255); wall.Material=Enum.Material.Neon; wall.Parent=workspace
  local foam=Instance.new("Part"); foam.Name="Tsunami Foam"; foam.Size=Vector3.new(13,4,420); foam.Position=wall.Position+Vector3.new(0,23,0); foam.Anchored=true; foam.CanCollide=false; foam.Color=Color3.fromRGB(225,250,255); foam.Material=Enum.Material.Neon; foam.Parent=workspace
  restore(function() if wall.Parent then wall:Destroy() end; if foam.Parent then foam:Destroy() end end); ctx.Base.ScareUnlocked()
