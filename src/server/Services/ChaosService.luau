   for _,player in ipairs(Players:GetPlayers()) do if not caught[player] then local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart"); local hum=player.Character and player.Character:FindFirstChildOfClass("Humanoid"); if root and math.abs(root.Position.X-x)<12 and math.abs(root.Position.Z)<215 then caught[player]=true; if root.Position.Y<11 then root.AssemblyLinearVelocity=Vector3.new(math.random(-45,45),105,math.random(-45,45)); local loss=math.floor(ctx.Coin.Get(player)*.10); if loss>0 then ctx.Coin.Add(player,-loss,"tsunami swept away 10%") end; ctx.Daily.Increment(player,"Launched",1); ctx.Announce.To(player,"The wave got you! High ground saved the smart ones.") else ctx.Announce.To(player,"You surfed the tsunami from high ground!") end end end end
   task.wait(.1) end end)
