end
function Chaos.StartNext() if Chaos.Last~="BRAINROT" and math.random()<.02 then Chaos.Start(Defs[#Defs]); return end; local choices={}; for _,d in ipairs(Defs) do if d.Name~="BRAINROT" and d.Name~=Chaos.Last then table.insert(choices,d) end end; local d=require(game:GetService("ReplicatedStorage").Modules.Util).WeightedPick(choices,function(x)return Config.Rarities[x.Rarity] and Config.Rarities[x.Rarity].Weight or 1 end); Chaos.Start(d) end
function Chaos.Start(def)
