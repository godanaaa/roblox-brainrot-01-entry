  for i=1,count do local chicken=makeChicken(Vector3.new(math.random(-150,150),3,math.random(-150,150)),size); table.insert(cleanup,function()if chicken.Parent then chicken:Destroy()end end); task.spawn(function() for j=1,def.Duration*2 do if not chicken.Parent then break end; local nearest,dist; for _,p in ipairs(Players:GetPlayers()) do local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart"); if root then local d=(root.Position-chicken.PrimaryPart.Position).Magnitude; if not dist or d<dist then nearest=root;dist=d end end end; if nearest and dist then local delta=nearest.Position-chicken.PrimaryPart.Position; if delta.Magnitude>2 then chicken:PivotTo(CFrame.new(chicken.PrimaryPart.Position+delta.Unit*1.2)) end; if dist<4 and def.Name=="Chicken Attack" then local p=Players:GetPlayerFromCharacter(nearest.Parent); if p then ctx.Coin.Add(p,-10,"chicken bite") end end end; task.wait(.5) end end) end
  if def.Name=="Chicken Attack" then ctx.Base.ScareUnlocked() end
 elseif def.Name=="Floor Is Lava" then local ground=Instance.new("Part"); ground.Name="Temporary Lava"; ground.Size=Vector3.new(400,1,400); ground.Position=Vector3.new(0,.7,0); ground.Anchored=true; ground.CanCollide=false; ground.Transparency=.25; ground.Color=Color3.fromRGB(255,70,20); ground.Material=Enum.Material.Neon; ground.Parent=workspace; table.insert(cleanup,function()ground:Destroy()end); task.spawn(function()for _=1,def.Duration do for _,p in ipairs(Players:GetPlayers())do local c=p.Character; local root=c and c:FindFirstChild("HumanoidRootPart"); local h=c and c:FindFirstChildOfClass("Humanoid"); if root and h and root.Position.Y<4 then h:TakeDamage(10) end end; task.wait(1)end end)
 elseif def.Name=="One Player Is Sus" then local ps=Players:GetPlayers(); local p=ps[math.random(1,#ps)]; if p then p:SetAttribute("SusCoins",true); ctx.Remotes.Announcement:FireClient(p,"psst... your income is doubled"); task.delay(def.Duration,function()if p.Parent then p:SetAttribute("SusCoins",false)end end) end
