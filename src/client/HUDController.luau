local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Remotes=ReplicatedStorage:WaitForChild("Remotes")
local HUD={}
local function round(instance,radius) local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,radius or 12); c.Parent=instance end
local function label(parent,name,size,pos,text,fontSize)
 local t=Instance.new("TextLabel"); t.Name=name; t.Size=size; t.Position=pos; t.BackgroundTransparency=1; t.Text=text; t.TextColor3=Color3.new(1,1,1); t.TextScaled=false; t.TextSize=fontSize or 18; t.Font=Enum.Font.FredokaOne; t.TextXAlignment=Enum.TextXAlignment.Left; t.Parent=parent; return t
end
function HUD.Init(player)
 local gui=Instance.new("ScreenGui"); gui.Name="BrainrotMayhemHUD"; gui.ResetOnSpawn=false; gui.IgnoreGuiInset=false; gui.Parent=player:WaitForChild("PlayerGui"); HUD.Gui=gui
 local top=Instance.new("Frame"); top.Name="StatusBar"; top.Position=UDim2.new(0,18,0,48); top.Size=UDim2.new(0,370,0,82); top.BackgroundColor3=Color3.fromRGB(28,20,45); top.BackgroundTransparency=.1; top.Parent=gui; round(top,14)
 HUD.Coins=label(top,"Coins",UDim2.new(1,-20,0,31),UDim2.new(0,12,0,7),"🪙 0 Meme Coins",22)
 HUD.Event=label(top,"Event",UDim2.new(1,-20,0,24),UDim2.new(0,12,0,39),"EVENT: neighborhood behaving",16)
 HUD.Timer=label(top,"Timer",UDim2.new(0,70,0,24),UDim2.new(1,-78,0,39),"",15); HUD.Timer.TextXAlignment=Enum.TextXAlignment.Right
 local meter=Instance.new("Frame"); meter.Name="ChaosTrack"; meter.Position=UDim2.new(0,18,0,140); meter.Size=UDim2.new(0,270,0,20); meter.BackgroundColor3=Color3.fromRGB(40,35,50); meter.Parent=gui; round(meter,10)
 HUD.Meter=Instance.new("Frame"); HUD.Meter.Name="Fill"; HUD.Meter.Size=UDim2.fromScale(0,1); HUD.Meter.BackgroundColor3=Color3.fromRGB(255,70,100); HUD.Meter.Parent=meter; round(HUD.Meter,10)
 HUD.Level=label(gui,"ChaosLevel",UDim2.new(0,290,0,22),UDim2.new(0,18,0,162),"NORMAL • chaos meter",15)
 HUD.PlayerCount=label(gui,"PlayerCount",UDim2.new(0,180,0,24),UDim2.new(1,-198,0,218),"Players: 1/20",15); HUD.PlayerCount.TextXAlignment=Enum.TextXAlignment.Right
 HUD.Objective=label(gui,"Objective",UDim2.new(0,390,0,28),UDim2.new(0,18,1,-58),"Catch a brainrot and bring it home!",17)
 HUD.EventBanner=Instance.new("TextLabel"); HUD.EventBanner.Name="EventBanner"; HUD.EventBanner.AnchorPoint=Vector2.new(.5,0); HUD.EventBanner.Position=UDim2.new(.5,0,0,34); HUD.EventBanner.Size=UDim2.new(.75,0,0,56); HUD.EventBanner.BackgroundColor3=Color3.fromRGB(255,80,110); HUD.EventBanner.TextColor3=Color3.new(1,1,1); HUD.EventBanner.TextScaled=true; HUD.EventBanner.Font=Enum.Font.FredokaOne; HUD.EventBanner.Visible=false; HUD.EventBanner.Parent=gui; round(HUD.EventBanner,15)
 HUD.Toast=Instance.new("TextLabel"); HUD.Toast.Name="Toast"; HUD.Toast.AnchorPoint=Vector2.new(.5,0); HUD.Toast.Position=UDim2.new(.5,0,0,100); HUD.Toast.Size=UDim2.new(.6,0,0,40); HUD.Toast.BackgroundColor3=Color3.fromRGB(45,32,58); HUD.Toast.TextColor3=Color3.new(1,1,1); HUD.Toast.TextScaled=true; HUD.Toast.Font=Enum.Font.FredokaOne; HUD.Toast.Visible=false; HUD.Toast.Parent=gui; round(HUD.Toast,12)
 local menu=Instance.new("TextButton"); menu.Name="OpenMenu"; menu.Position=UDim2.new(1,-145,0,48); menu.Size=UDim2.fromOffset(125,42); menu.Text="☰  MENU"; menu.TextScaled=true; menu.Font=Enum.Font.FredokaOne; menu.TextColor3=Color3.new(1,1,1); menu.BackgroundColor3=Color3.fromRGB(125,60,190); menu.Parent=gui; round(menu,12); menu.Activated:Connect(function() if HUD.OpenMenu then HUD.OpenMenu() end end)
 HUD.LeaderboardLabel=Instance.new("TextLabel"); HUD.LeaderboardLabel.Name="TopPlayers"; HUD.LeaderboardLabel.Position=UDim2.new(1,-205,0,98); HUD.LeaderboardLabel.Size=UDim2.fromOffset(185,112); HUD.LeaderboardLabel.BackgroundColor3=Color3.fromRGB(28,20,45); HUD.LeaderboardLabel.BackgroundTransparency=.15; HUD.LeaderboardLabel.TextColor3=Color3.new(1,1,1); HUD.LeaderboardLabel.TextSize=15; HUD.LeaderboardLabel.Font=Enum.Font.FredokaOne; HUD.LeaderboardLabel.TextYAlignment=Enum.TextYAlignment.Top; HUD.LeaderboardLabel.Text="TOP MEME EARNERS\nLoading…"; HUD.LeaderboardLabel.Parent=gui; round(HUD.LeaderboardLabel,12)
 local interact=Instance.new("TextButton"); interact.Name="TouchInteract"; interact.AnchorPoint=Vector2.new(1,1); interact.Position=UDim2.new(1,-24,1,-110); interact.Size=UDim2.fromOffset(100,58); interact.Text="HOLD E\nCATCH"; interact.TextScaled=true; interact.Font=Enum.Font.FredokaOne; interact.TextColor3=Color3.new(1,1,1); interact.BackgroundColor3=Color3.fromRGB(35,170,120); interact.Parent=gui; round(interact,18); HUD.InteractButton=interact
 local emote=Instance.new("TextButton"); emote.Name="TouchEmote"; emote.AnchorPoint=Vector2.new(1,1); emote.Position=UDim2.new(1,-24,1,-178); emote.Size=UDim2.fromOffset(100,50); emote.Text="EMOTE G"; emote.TextScaled=true; emote.Font=Enum.Font.FredokaOne; emote.TextColor3=Color3.new(1,1,1); emote.BackgroundColor3=Color3.fromRGB(55,105,205); emote.Parent=gui; round(emote,16); HUD.EmoteButton=emote
 Remotes.State.OnClientEvent:Connect(function(state) if type(state)~="table" then return end; if state.Coins then HUD.Coins.Text="🪙 "..tostring(state.Coins).." Meme Coins" end; if state.Event then HUD.Event.Text="EVENT: "..state.Event end; if state.Players then HUD.PlayerCount.Text="Players: "..state.Players.."/20" end; if state.Chaos then HUD.SetChaos(state.Chaos) end; if state.Owned and #state.Owned>0 then HUD.Objective.Text="Expand your base, lock it, and survive the next event!" else HUD.Objective.Text="Catch a brainrot and bring it home!" end; if state.Daily then HUD.Daily=state.Daily; HUD.DailyProgress=state.Progress end; if state.Leaderboard then HUD.Leaderboard=state.Leaderboard; local rows={"TOP MEME EARNERS"}; for i,row in ipairs(state.Leaderboard)do table.insert(rows,i..". "..row.Name.."  "..row.Coins)end; HUD.LeaderboardLabel.Text=table.concat(rows,"\n") end; if state.Playing~=nil then HUD.Playing=state.Playing end end)
 Remotes.Event.OnClientEvent:Connect(function(event) if event.Name then HUD.Event.Text="EVENT: "..event.Name; HUD.ShowBanner("⚡ "..event.Name.." ⚡",event.Duration or 4); local untilAt=os.clock()+(event.Duration or 0); task.spawn(function()while os.clock()<untilAt do HUD.Timer.Text=tostring(math.ceil(untilAt-os.clock())).."s"; task.wait(.25)end; HUD.Timer.Text=""end) end end)
 Remotes.Announcement.OnClientEvent:Connect(function(text) HUD.ShowToast(text) end)
 HUD.SetChaos(0)
end
function HUD.ShowBanner(text,duration) HUD.EventBanner.Text=text; HUD.EventBanner.Visible=true; task.delay(math.max(2,math.min(duration or 4,8)),function() HUD.EventBanner.Visible=false end) end
function HUD.ShowToast(text) HUD.Toast.Text=text; HUD.Toast.Visible=true; task.delay(3.5,function()HUD.Toast.Visible=false end) end
function HUD.SetChaos(value) local n=math.clamp(tonumber(value) or 0,0,100); HUD.Meter.Size=UDim2.fromScale(n/100,1); local names={{20,"NORMAL"},{45,"CHAOTIC"},{70,"INSANE"},{90,"BRAINROT"},{101,"ABSOLUTE DISASTER"}}; local title="NORMAL"; for _,entry in ipairs(names)do if n<entry[1] then title=entry[2]; break end end; HUD.Level.Text=title.." • chaos "..n.."%" end
return HUD
