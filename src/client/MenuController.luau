local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Remotes=ReplicatedStorage:WaitForChild("Remotes")
local Menu={}
local function round(obj) local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,14); c.Parent=obj end
function Menu.Init(player,hud)
 Menu.Player=player; Menu.HUD=hud
 local overlay=Instance.new("Frame"); overlay.Name="MenuOverlay"; overlay.Size=UDim2.fromScale(1,1); overlay.BackgroundColor3=Color3.fromRGB(15,11,30); overlay.BackgroundTransparency=.12; overlay.Visible=true; overlay.Parent=hud.Gui; Menu.Overlay=overlay
 local card=Instance.new("Frame"); card.AnchorPoint=Vector2.new(.5,.5); card.Position=UDim2.fromScale(.5,.5); card.Size=UDim2.new(.82,0,.78,0); card.BackgroundColor3=Color3.fromRGB(34,23,55); card.Parent=overlay; round(card)
 local title=Instance.new("TextLabel"); title.Name="Title"; title.Position=UDim2.new(.05,0,.03,0); title.Size=UDim2.new(.9,0,.18,0); title.BackgroundTransparency=1; title.Text="BRAINROT\nMAYHEM"; title.TextColor3=Color3.fromRGB(255,230,80); title.Font=Enum.Font.FredokaOne; title.TextScaled=true; title.Parent=card
 local subtitle=Instance.new("TextLabel"); subtitle.Position=UDim2.new(.1,0,.23,0); subtitle.Size=UDim2.new(.8,0,.07,0); subtitle.BackgroundTransparency=1; subtitle.Text="Catch weirdos. Build your base. Survive the chaos."; subtitle.TextColor3=Color3.new(1,1,1); subtitle.TextScaled=true; subtitle.Font=Enum.Font.GothamBold; subtitle.Parent=card
 local content=Instance.new("Frame"); content.Name="PanelContent"; content.Position=UDim2.new(.27,0,.34,0); content.Size=UDim2.new(.68,0,.6,0); content.BackgroundColor3=Color3.fromRGB(48,36,69); content.Parent=card; round(content); Menu.Content=content
 local nav=Instance.new("Frame"); nav.Position=UDim2.new(.04,0,.34,0); nav.Size=UDim2.new(.2,0,.6,0); nav.BackgroundTransparency=1; nav.Parent=card
 local list=Instance.new("UIListLayout"); list.Padding=UDim.new(0,7); list.Parent=nav
 local function button(name,callback)
  local b=Instance.new("TextButton"); b.Name=name; b.Size=UDim2.new(1,0,0,38); b.BackgroundColor3=Color3.fromRGB(128,65,190); b.Text=name; b.TextColor3=Color3.new(1,1,1); b.TextScaled=true; b.Font=Enum.Font.FredokaOne; b.Parent=nav; round(b); b.Activated:Connect(callback); return b
 end
 local function clear() for _,o in ipairs(content:GetChildren())do if not o:IsA("UICorner") then o:Destroy()end end end
 local function info(text) clear(); local t=Instance.new("TextLabel"); t.Size=UDim2.new(1,-24,1,-20); t.Position=UDim2.new(0,12,0,10); t.BackgroundTransparency=1; t.Text=text; t.TextColor3=Color3.new(1,1,1); t.TextWrapped=true; t.TextYAlignment=Enum.TextYAlignment.Top; t.TextXAlignment=Enum.TextXAlignment.Left; t.TextSize=20; t.Font=Enum.Font.GothamBold; t.Parent=content end
 local function play() overlay.Visible=false; Remotes.Play:FireServer(); hud.ShowToast("Welcome to the neighborhood. Go catch something weird!") end
 local function shop() clear(); local sc=Instance.new("ScrollingFrame"); sc.Size=UDim2.fromScale(1,1); sc.BackgroundTransparency=1; sc.BorderSizePixel=0; sc.CanvasSize=UDim2.new(0,0,0,0); sc.Parent=content; local layout=Instance.new("UIListLayout"); layout.Padding=UDim.new(0,5); layout.Parent=sc; local items={"Base Lock","Next Slot","Giant Head","Banana Sword","Chicken Pet","Toilet Mount","Meme Face","Exploding Backpack","Funny Trail","Silly Animations","Transformation","Brainrot:Baron von Banana","Brainrot:Madame Lampshade","Brainrot:General Sock","Brainrot:The Fridge King","Brainrot:Countess Washing Machine","Brainrot:Grandma's WiFi Router","Brainrot:The Almighty Printer","Pet:Chicken","Pet:Banana","Pet:Potato","Pet:Toilet","Pet:Mini NPC","Pet:Giant Hamster","Pet:Dancing Frog","Pet:Floating Head"}; for _,item in ipairs(items)do local b=Instance.new("TextButton"); b.Size=UDim2.new(1,-12,0,40); b.BackgroundColor3=Color3.fromRGB(100,57,150); b.TextColor3=Color3.new(1,1,1); b.TextScaled=true; b.Font=Enum.Font.FredokaOne; local price=item:sub(1,9)=="Brainrot:" and ({["Baron von Banana"]=1000,["Madame Lampshade"]=1500,["General Sock"]=2000,["The Fridge King"]=5000,["Countess Washing Machine"]=6500,["Grandma's WiFi Router"]=20000,["The Almighty Printer"]=30000})[item:sub(10)] or item=="Transformation" and 150 or item=="Base Lock" and 100 or item=="Next Slot" and 500 or item:sub(1,4)=="Pet:" and ({Chicken=300,Banana=450,Potato=500,Toilet=800,["Mini NPC"]=900,["Giant Hamster"]=1200,["Dancing Frog"]=1000,["Floating Head"]=1500})[item:sub(5)] or nil; b.Text=(item:sub(1,9)=="Brainrot:" and item:sub(10) or item:sub(1,4)=="Pet:" and (item:sub(5).." Pet") or item)..(price and "  •  "..price.." coins" or "  •  BUY"); b.Parent=sc; round(b); b.Activated:Connect(function()Remotes.Buy:FireServer(item); Remotes.State:FireServer("Request")end) end; task.defer(function()sc.CanvasSize=UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+8)end) end
 local function pets() local owned=(Menu.State and Menu.State.OwnedPets) or {}; info("PETS\n\nOwned companions follow you around. Buy pets in SHOP, then equip one here."); for i,name in ipairs({"Chicken","Banana","Potato","Toilet","Dancing Frog"})do local isOwned=owned[name]; local b=Instance.new("TextButton"); b.Position=UDim2.new(.05,0,.42+(i-1)*.1,0); b.Size=UDim2.new(.42,0,.08,0); b.Text=isOwned and "Equip "..name or "Buy "..name; b.TextScaled=true; b.Font=Enum.Font.FredokaOne; b.BackgroundColor3=Color3.fromRGB(80,120,170); b.TextColor3=Color3.new(1,1,1); b.Parent=content; round(b); b.Activated:Connect(function()if isOwned then Remotes.EquipPet:FireServer(name)else Remotes.Buy:FireServer("Pet:"..name)end end)end end
 local function inventory() local st=Menu.State or {}; local owned=st.Owned or {}; local text="YOUR BRAINROT COLLECTION\n\n"; if #owned==0 then text..="No brainrots yet. Explore and hold E near one!" else for _,r in ipairs(owned)do text..="• "..(r.Mutation and r.Mutation.." " or "")..r.Name.."  +"..r.Rate.."/sec\n" end end; info(text) end
 local function daily() Remotes.Panel:FireServer("Daily"); task.delay(.25,function() local state=Menu.State or {}; local progress=state.Progress or {}; local lines={"DAILY CHALLENGES"}; for _,challenge in ipairs(state.Daily or {})do table.insert(lines,"\n"..challenge.Name.."  ["..math.min(progress[challenge.Key] or 0,challenge.Goal).."/"..challenge.Goal.."]  •  "..challenge.Reward.." coins")end; info(table.concat(lines,"\n"))end) end
 local function emotes() info("EMOTES\n\nPress G to spin, dance, point, cry, flop, or shake your head. Emotes are purely for chaos.") end
 button("▶ PLAY",play); button("🛒 SHOP",shop); button("🐣 PETS",pets); button("🎒 INVENTORY",inventory); button("💃 EMOTES",emotes); button("📅 DAILY",daily); button("⚙ SETTINGS",function()info("SETTINGS\n\nMusic: built-in game sounds only\nSFX: enabled\nCamera shake: subtle event shake\n\nSettings are local to this play session.")end)
 info("Welcome to the most normal neighborhood on Roblox.\n\nCatch brainrots, fill your base, collect Meme Coins, and brace for events every 20–40 seconds. Five hidden buttons are scattered around town.")
 hud.OpenMenu=function() overlay.Visible=not overlay.Visible end
 Remotes.State.OnClientEvent:Connect(function(s) if type(s)=="table" then Menu.State=s end end)
end
return Menu
