 local function play() overlay.Visible=false; Remotes.Play:FireServer(); hud.ShowToast("Welcome to the neighborhood. Go catch something weird!") end
 local function shop() clear(); local sc=Instance.new("ScrollingFrame"); sc.Size=UDim2.fromScale(1,1); sc.BackgroundTransparency=1; sc.BorderSizePixel=0; sc.CanvasSize=UDim2.new(0,0,0,0); sc.Parent=content; local layout=Instance.new("UIListLayout"); layout.Padding=UDim.new(0,5); layout.Parent=sc; local items={"Base Lock","Next Slot","Giant Head","Banana Sword","Chicken Pet","Toilet Mount","Meme Face","Exploding Backpack","Funny Trail","Silly Animations","Transformation","Brainrot:Baron von Banana","Brainrot:Madame Lampshade","Brainrot:General Sock","Brainrot:Doctor Doorknob","Brainrot:Lady Loo Roll","Brainrot:The Fridge King","Brainrot:Countess Washing Machine","Brainrot:Sultan of the Sofa","Brainrot:Grandma's WiFi Router","Brainrot:The Almighty Printer","Brainrot:Duke of Dishwashers","Brainrot:Princess Pillow","Brainrot:Emperor of Escalators","Brainrot:Queen of Queues","Brainrot:The Last Slice of Pizza","Pet:Chicken","Pet:Banana","Pet:Potato","Pet:Toilet","Pet:Mini NPC","Pet:Giant Hamster","Pet:Dancing Frog","Pet:Floating Head"}; for _,item in ipairs(items)do local b=Instance.new("TextButton"); b.Size=UDim2.new(1,-12,0,40); b.BackgroundColor3=Color3.fromRGB(100,57,150); b.TextColor3=Color3.new(1,1,1); b.TextScaled=true; b.Font=Enum.Font.FredokaOne; local price=item:sub(1,9)=="Brainrot:" and ({["Baron von Banana"]=1000,["Madame Lampshade"]=1500,["General Sock"]=2000,["Doctor Doorknob"]=2200,["Lady Loo Roll"]=2700,["The Fridge King"]=5000,["Countess Washing Machine"]=6500,["Sultan of the Sofa"]=8000,["Grandma's WiFi Router"]=20000,["The Almighty Printer"]=30000,["Duke of Dishwashers"]=6000,["Princess Pillow"]=8000,["Emperor of Escalators"]=14000,["Queen of Queues"]=17000,["The Last Slice of Pizza"]=24000})[item:sub(10)] or item=="Transformation" and 150 or item=="Base Lock" and 100 or item=="Next Slot" and 500 or item:sub(1,4)=="Pet:" and ({Chicken=300,Banana=450,Potato=500,Toilet=800,["Mini NPC"]=900,["Giant Hamster"]=1200,["Dancing Frog"]=1000,["Floating Head"]=1500})[item:sub(5)] or nil; b.Text=(item:sub(1,9)=="Brainrot:" and item:sub(10) or item:sub(1,4)=="Pet:" and (item:sub(5).." Pet") or item)..(price and "  •  "..price.." coins" or "  •  BUY"); b.Parent=sc; round(b); b.Activated:Connect(function()Remotes.Buy:FireServer(item); Remotes.State:FireServer("Request")end) end; task.defer(function()sc.CanvasSize=UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+8)end) end
 local function pets() local owned=(Menu.State and Menu.State.OwnedPets) or {}; info("PETS\n\nOwned companions follow you around. Equip one here or unequip your current buddy."); for i,name in ipairs({"Chicken","Banana","Potato","Toilet","Mini NPC","Giant Hamster","Dancing Frog","Floating Head"})do local isOwned=owned[name]; local col=(i-1)%2; local row=math.floor((i-1)/2); local b=Instance.new("TextButton"); b.Position=UDim2.new(.04+col*.48,0,.39+row*.105,0); b.Size=UDim2.new(.44,0,.085,0); b.Text=isOwned and "Equip "..name or "Buy "..name; b.TextScaled=true; b.Font=Enum.Font.FredokaOne; b.BackgroundColor3=Color3.fromRGB(80,120,170); b.TextColor3=Color3.new(1,1,1); b.Parent=content; round(b); b.Activated:Connect(function()if isOwned then Remotes.EquipPet:FireServer(name)else Remotes.Buy:FireServer("Pet:"..name)end end)end; local off=Instance.new("TextButton"); off.Position=UDim2.new(.3,0,.84,0); off.Size=UDim2.new(.4,0,.08,0); off.Text="Unequip pet"; off.TextScaled=true; off.Font=Enum.Font.FredokaOne; off.BackgroundColor3=Color3.fromRGB(90,75,110); off.TextColor3=Color3.new(1,1,1); off.Parent=content; round(off); off.Activated:Connect(function()Remotes.EquipPet:FireServer("__UNEQUIP__")end) end
 local function inventory() local st=Menu.State or {}; local owned=st.Owned or {}; local text="YOUR BRAINROT COLLECTION\n\n"; if #owned==0 then text..="No brainrots yet. Explore and hold E near one!" else for _,r in ipairs(owned)do text..="• "..(r.Mutation and r.Mutation.." " or "")..r.Name.."  +"..r.Rate.."/sec\n" end end; info(text) end
 local function daily() Remotes.Panel:FireServer("Daily"); task.delay(.25,function() local state=Menu.State or {}; local progress=state.Progress or {}; local lines={"DAILY CHALLENGES"}; for _,challenge in ipairs(state.Daily or {})do table.insert(lines,"\n"..challenge.Name.."  ["..math.min(progress[challenge.Key] or 0,challenge.Goal).."/"..challenge.Goal.."]  •  "..challenge.Reward.." coins")end; info(table.concat(lines,"\n"))end) end
 local function indexPanel() local st=Menu.State or {}; local found=st.FoundBrainrots or {}; local rows={"BRAINROT INDEX", "INDEX  "..tostring(st.IndexFound or 0).."/"..tostring(st.IndexTotal or #Config.Brainrots).." found", ""}; for _,entry in ipairs(Config.Brainrots) do local name=entry.Name; table.insert(rows,(found[name] and "✓  " or "□  ")..name.."  •  "..entry.Rarity) end; info(table.concat(rows,"\n")) end
 local function emotes() info("EMOTES\n\nPress G to spin, dance, point, cry, flop, or shake your head. Emotes are purely for chaos.") end
 local function upgrades()
  clear()
  local levels=(Menu.State and Menu.State.Upgrades) or { ["Income Boost"]=0, ["Base Shield"]=0 }
  local rows={
   {"Income Boost",levels["Income Boost"] or 0,5,{1000,2500,6000,15000,40000},"+10% income per level"},
   {"Base Shield",levels["Base Shield"] or 0,3,{500,1500,4000},"+30s base lock per level"},
  }
  local heading=Instance.new("TextLabel"); heading.Size=UDim2.new(1,-24,0,52); heading.Position=UDim2.new(0,12,0,6); heading.BackgroundTransparency=1; heading.Text="UPGRADES"; heading.TextColor3=Color3.fromRGB(255,230,80); heading.TextSize=28; heading.Font=Enum.Font.FredokaOne; heading.Parent=content
  for index,row in ipairs(rows) do
   local y=72+(index-1)*108
   local text=Instance.new("TextLabel"); text.Position=UDim2.new(0,14,0,y); text.Size=UDim2.new(.62,-12,0,88); text.BackgroundTransparency=1; text.TextXAlignment=Enum.TextXAlignment.Left; text.TextYAlignment=Enum.TextYAlignment.Center; text.TextWrapped=true; text.TextColor3=Color3.new(1,1,1); text.TextSize=18; text.Font=Enum.Font.GothamBold
   local cost=row[2]<row[3] and row[4][row[2]+1] or nil
   text.Text=row[1].."  Lv "..row[2].."/"..row[3].."\n"..row[5]..(cost and ("\nNext: "..cost.." coins") or "\nMAX LEVEL")
   text.Parent=content
   if cost then
    local buy=Instance.new("TextButton"); buy.Position=UDim2.new(.66,0,0,y+22); buy.Size=UDim2.new(.29,0,0,48); buy.Text="UPGRADE"; buy.TextScaled=true; buy.Font=Enum.Font.FredokaOne; buy.TextColor3=Color3.new(1,1,1); buy.BackgroundColor3=Color3.fromRGB(70,155,105); buy.Parent=content; round(buy)
    buy.Activated:Connect(function() Remotes.Buy:FireServer("Upgrade:"..row[1]); task.delay(.2,function() Remotes.State:FireServer("Request") end) end)
   end
  end
 end
 button("▶ PLAY",play); button("🛒 SHOP",shop); button("🐣 PETS",pets); button("🎒 INVENTORY",inventory); button("📚 INDEX",indexPanel); button("💃 EMOTES",emotes); button("📅 DAILY",daily); button("♻ REBIRTH",function() local st=Menu.State or {}; info("REBIRTH LADDER\n\nKeep pets and cosmetics, reset coins and base brainrots, and gain +25% income permanently.\n\nCurrent multiplier: x"..string.format("%.2f",st.RebirthMultiplier or 1).."\nLifetime earned needed: "..tostring(st.RebirthCost or "MAX").." coins"); local b=Instance.new("TextButton"); b.Position=UDim2.new(.08,0,.72,0); b.Size=UDim2.new(.84,0,.14,0); b.Text="REBIRTH NOW"; b.TextScaled=true; b.Font=Enum.Font.FredokaOne; b.TextColor3=Color3.new(1,1,1); b.BackgroundColor3=Color3.fromRGB(185,55,115); b.Parent=content; round(b); b.Activated:Connect(function() Remotes.Rebirth:FireServer(); Remotes.State:FireServer("Request") end) end); button("⚙ SETTINGS",function()info("SETTINGS\n\nMusic: built-in game sounds only\nSFX: enabled\nCamera shake: subtle event shake\n\nSettings are local to this play session.")end)
 info("Welcome to the most normal neighborhood on Roblox.\n\nCatch brainrots, fill your base, collect Meme Coins, and brace for events every 20–40 seconds. Five hidden buttons are scattered around town. Rarity ladder: COMMON → UNCOMMON → RARE → EPIC → LEGENDARY → MYTHIC.")
 hud.OpenMenu=function() overlay.Visible=not overlay.Visible end
 Remotes.State.OnClientEvent:Connect(function(s) if type(s)~="table" then return end; Menu.State=s; local buttons=Menu.QuickButtons; if not buttons then return end; if s.LockSeconds~=nil then buttons.Lock.Text=s.LockSeconds>0 and ("LOCKED "..tostring(s.LockSeconds).."s") or "LOCK [L]" end; if s.IndexTotal then buttons.Index.Text="INDEX "..tostring(s.IndexFound or 0).."/"..tostring(s.IndexTotal) end; if s.RebirthMultiplier then buttons.Rebirth.Text="REBIRTH $"..compactCoins(s.RebirthCost).." ×"..string.format("%.2f",s.RebirthMultiplier) end; if s.Upgrades then buttons.Upgrades.Text="UPGRADES Lv "..tostring(s.Upgrades["Income Boost"] or 0) end end)
 local CAS=game:GetService("ContextActionService")
 local function openPanel(panel) if panel=="Lock" then Remotes.Buy:FireServer("Base Lock"); task.delay(.15,function()Remotes.State:FireServer("Request")end); return end; overlay.Visible=true; if panel=="Shop" then shop() elseif panel=="Pets" then pets() elseif panel=="Emotes" then emotes() elseif panel=="Upgrades" then upgrades() elseif panel=="Rebirth" then info("REBIRTH LADDER\n\nCurrent multiplier x"..string.format("%.2f",(Menu.State and Menu.State.RebirthMultiplier) or 1)..". Press the Rebirth button in the menu to claim when eligible.") end end
 local stack=Instance.new("Frame"); stack.Name="QuickActions"; stack.AnchorPoint=Vector2.new(1,.5); stack.Position=UDim2.new(1,-18,.5,0); stack.Size=UDim2.fromOffset(168,334); stack.BackgroundTransparency=1; stack.Parent=hud.Gui; Menu.QuickButtons={}
 local entries={{"SHOP [B]","Shop",Enum.KeyCode.B},{"PETS [P]","Pets",Enum.KeyCode.P},{"EMOTES [G]","Emotes",Enum.KeyCode.G},{"REBIRTH","Rebirth",Enum.KeyCode.R},{"UPGRADES","Upgrades",Enum.KeyCode.U},{"LOCK","Lock",Enum.KeyCode.L},{"INDEX","Index",nil}}
 for i,pair in ipairs(entries) do local b=Instance.new("TextButton"); b.Name=pair[2]; b.Position=UDim2.new(0,0,0,(i-1)*47); b.Size=UDim2.fromOffset(168,41); b.Text=pair[1]; b.TextSize=17; b.TextScaled=true; b.Font=Enum.Font.FredokaOne; b.TextColor3=Color3.new(1,1,1); b.BackgroundColor3=Color3.fromRGB(105,55,160); b.Parent=stack; round(b); Menu.QuickButtons[pair[2]]=b; b.Activated:Connect(function() if pair[2]=="Index" then overlay.Visible=true; indexPanel() else openPanel(pair[2]) end end); if pair[3] then CAS:BindAction("Quick"..pair[2],function(_,state)if state==Enum.UserInputState.Begin then openPanel(pair[2]); return Enum.ContextActionResult.Sink end; return Enum.ContextActionResult.Pass end,false,pair[3]) end end
